# Copy to .env (git-ignored). Loaded by src/server.ts and src/server-dev.ts via dotenv;
# variables already set in the process environment take precedence.

# --- Multiple projects / environments (lifts the OSS default-project gate) ---
UNLEASH_MULTI_PROJECT=true

# --- Lark login via lark-auth-backoffice V2 (see LARK_AUTH.md) ---
# Leaving LARK_AUTH_MODULE_CODE empty keeps Unleash's default password login.
LARK_AUTH_FRONTEND_URL=https://lark-auth-web-v2.igo8.me
LARK_AUTH_BACKEND_URL=https://lark-auth-server-v2.igo8.me
LARK_AUTH_MODULE_CODE=UNLEASH
# Public URL of this Unleash; lark-auth redirects back to ${UNLEASH_URL}/auth/lark/callback
UNLEASH_URL=http://localhost:4242
# Root role for first-time Lark users: Viewer (default) | Editor | Admin
# LARK_AUTH_DEFAULT_ROLE=Viewer
# OSS default is 5 parallel sessions per user (the UI warns above that)
MAX_PARALLEL_SESSIONS=20
